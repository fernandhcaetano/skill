 "captions": [
  {
   "start": 0.043,
   "end": 1.733,
   "text": "Você sabia que a cada peça"
  },
  {
   "start": 1.733,
   "end": 3.033,
   "text": "que você compra na Reserva,"
  },
  {
   "start": 3.083,
   "end": 4.6,
   "text": "cinco pratos são complementados?"
  },
  {
   "start": 4.6,
   "end": 6.1,
   "text": "Sim, esse é o 1P5P,"
  },
  {
   "start": 6.16,
   "end": 8.0,
   "text": "um projeto que há 10 anos"
  },
  {
   "start": 8.05,
   "end": 10.05,
   "text": "providencia complementação alimentar"
  },
  {
   "start": 10.09,
   "end": 10.75,
   "text": "para quem precisa."
  },
  {
   "start": 11.01,
   "end": 12.7,
   "text": "E esse ano, ele completa 10 anos."
  },
  {
   "start": 15.2,
   "end": 16.72,
   "text": "Oi, eu sou a Ludy,"
  },
  {
   "start": 16.77,
   "end": 19.067,
   "text": "do time de Sustentabilidade do grupo."
  },
  {
   "start": 19.067,
   "end": 20.784,
   "text": "Hoje estamos aqui para celebrar"
  },
  {
   "start": 20.784,
   "end": 22.667,
   "text": "o Dia Mundial da Alimentação"
  },
  {
   "start": 22.667,
   "end": 23.95,
   "text": "e trouxemos pessoas"
  },
  {
   "start": 23.95,
   "end": 25.533,
   "text": "de diferentes áreas da marca"
  },
  {
   "start": 25.533,
   "end": 26.767,
   "text": "para poder vivenciar"
  },
  {
   "start": 26.767,
   "end": 27.967,
   "text": "esse projeto na prática."
  },
  {
   "start": 27.98,
   "end": 29.467,
   "text": "Estamos aqui na Escola DOM"
  },
  {
   "start": 29.467,
   "end": 32.033,
   "text": "e, junto com times de sede, CD e marca,"
  },
  {
   "start": 32.033,
   "end": 34.467,
   "text": "vamos experienciar essa iniciativa na prática."
  },
  {
   "start": 34.467,
   "end": 35.867,
   "text": "Foi um dia de muita troca,"
  },
  {
   "start": 35.867,
   "end": 37.233,
   "text": "aprendizado e celebração."
  },
  {
   "start": 37.236,
   "end": 38.683,
   "text": "Junto com a chefe Neide Marco,"
  },
  {
   "start": 38.683,
   "end": 40.533,
   "text": "já parceira de longo prazo do projeto,"
  },
  {
   "start": 40.533,
   "end": 41.933,
   "text": "as crianças participaram"
  },
  {
   "start": 41.933,
   "end": 43.0,
   "text": "de uma oficina de cupcakes"
  },
  {
   "start": 43.0,
   "end": 44.417,
   "text": "e puderam mostrar um pouco mais"
  },
  {
   "start": 44.417,
   "end": 45.833,
   "text": "da escola para o nosso time."
  },
  {
   "start": 45.836,
   "end": 47.666,
   "text": "Isso reforça a importância"
  },
  {
   "start": 47.666,
   "end": 49.633,
   "text": "do aproveitamento alimentar."
  },
  {
   "start": 49.633,
   "end": 52.0,
   "text": "E também podemos, nessa troca, trazer"
  },
  {
   "start": 52.0,
   "end": 53.633,
   "text": "o nosso encantamento para a escola,"
  },
  {
   "start": 53.633,
   "end": 54.6,
   "text": "com a presença do Rê,"
  },
  {
   "start": 54.6,
   "end": 55.5,
   "text": "nosso mascote,"
  },
  {
   "start": 55.5,
   "end": 56.567,
   "text": "que celebrou com a gente"
  },
  {
   "start": 56.567,
   "end": 57.633,
   "text": "esse momento tão importante."
  },
  {
   "start": 57.636,
   "end": 59.116,
   "text": "Celebrar 10 anos é reconhecer"
  },
  {
   "start": 59.116,
   "end": 60.433,
   "text": "que cada prato importa"
  },
  {
   "start": 60.436,
   "end": 61.766,
   "text": "e que seguimos juntos,"
  },
  {
   "start": 61.767,
   "end": 63.167,
   "text": "fortalecendo essa rede,"
  },
  {
   "start": 63.167,
   "end": 64.667,
   "text": "que trabalha para complementar"
  },
  {
   "start": 64.667,
   "end": 66.067,
   "text": "a alimentação de quem precisa."
  }
 ],
